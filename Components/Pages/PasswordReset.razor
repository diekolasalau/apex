@page "/password-reset/{token}"
@using StudyMgt.Services
@using StudyMgt.Data.Entities
@inject CentreAdminAccessService AdminAccess
@inject AppAuditLogService AuditLog
@inject NavigationManager Navigation

<PageTitle>Reset Password - Centre Administrator</PageTitle>

<div class="auth-container">
    <div class="auth-card" style="max-width: 480px;">
        @if (validatingToken)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Validating reset token...</p>
            </div>
        }
        else if (adminAccount == null)
        {
            <h1>Invalid Reset Link</h1>
            <p class="text-danger">The password reset link is invalid or has expired. Please request a new one.</p>
            <a href="/password-reset-request" class="btn btn-primary w-100">Request New Reset Link</a>
        }
        else
        {
            <h1>Set New Password</h1>
            <p class="text-muted">Enter a new password for your account.</p>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">@successMessage</div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            @if (!passwordReset)
            {
                <form @onsubmit="ResetPasswordAsync">
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <InputText type="password" class="form-control" @bind-Value="newPassword" placeholder="At least 8 characters" required />
                        <div class="form-text">Password must be at least 8 characters long.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Confirm Password</label>
                        <InputText type="password" class="form-control" @bind-Value="confirmPassword" placeholder="Re-enter your password" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Resetting...</span>
                        }
                        else
                        {
                            <span>Reset Password</span>
                        }
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-success">
                    <h5>Password Reset Successful</h5>
                    <p>Your password has been reset. You can now sign in with your new password.</p>
                </div>
                <a href="/centre-administrators" class="btn btn-primary w-100">Sign In</a>
            }
        }

        <hr />
        <p class="text-center">
            <a href="/centre-administrators">Back to Sign In</a>
        </p>
    </div>
</div>

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 20px;
    }

    .auth-card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 40px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .auth-card h1 {
        margin-bottom: 10px;
        font-size: 28px;
        font-weight: 600;
        color: #333;
    }

    .auth-card p {
        margin-bottom: 30px;
        font-size: 14px;
    }

    .auth-card hr {
        margin: 25px 0;
        border: 0;
        border-top: 1px solid #e0e0e0;
    }

    .text-center {
        text-align: center;
        font-size: 14px;
    }

    .text-center a {
        color: #007bff;
        text-decoration: none;
    }

    .text-center a:hover {
        text-decoration: underline;
    }

    .form-text {
        display: block;
        margin-top: 5px;
        font-size: 13px;
        color: #6c757d;
    }
</style>

@code {
    [Parameter]
    public string? Token { get; set; }

    private CentreAdminPortalAccountEntity? adminAccount;
    private string? newPassword;
    private string? confirmPassword;
    private string? errorMessage;
    private string? successMessage;
    private bool validatingToken = true;
    private bool isSubmitting = false;
    private bool passwordReset = false;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            errorMessage = "No reset token provided.";
            validatingToken = false;
            return;
        }

        try
        {
            adminAccount = await AdminAccess.ValidateResetTokenAsync(Token);
            if (adminAccount == null)
            {
                await AuditLog.LogAsync(
                    eventType: "Security",
                    action: "PasswordResetInvalidToken",
                    pagePath: "/password-reset",
                    actorRole: "CentreAdmin",
                    actorUsername: "unknown",
                    success: false,
                    details: "Invalid or expired password reset token used.");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while validating the reset token.";
            await AuditLog.LogAsync(
                eventType: "Security",
                action: "PasswordResetTokenValidationError",
                pagePath: "/password-reset",
                actorRole: "CentreAdmin",
                actorUsername: "unknown",
                success: false,
                details: $"Error: {ex.Message}");
        }
        finally
        {
            validatingToken = false;
        }
    }

    private async Task ResetPasswordAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "Please fill in all fields.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (newPassword.Length < 8)
        {
            errorMessage = "Password must be at least 8 characters long.";
            return;
        }

        isSubmitting = true;

        try
        {
            var (success, message) = await AdminAccess.ResetPasswordAsync(Token!, newPassword);

            if (success)
            {
                successMessage = message;
                passwordReset = true;
                await AuditLog.LogAsync(
                    eventType: "Security",
                    action: "PasswordResetSuccess",
                    pagePath: "/password-reset",
                    actorRole: "CentreAdmin",
                    actorUsername: adminAccount?.Username ?? "unknown",
                    success: true,
                    details: "Centre administrator password reset successfully.");
            }
            else
            {
                errorMessage = message;
                await AuditLog.LogAsync(
                    eventType: "Security",
                    action: "PasswordResetFailed",
                    pagePath: "/password-reset",
                    actorRole: "CentreAdmin",
                    actorUsername: adminAccount?.Username ?? "unknown",
                    success: false,
                    details: message);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while resetting your password.";
            await AuditLog.LogAsync(
                eventType: "Security",
                action: "PasswordResetError",
                pagePath: "/password-reset",
                actorRole: "CentreAdmin",
                actorUsername: adminAccount?.Username ?? "unknown",
                success: false,
                details: $"Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
