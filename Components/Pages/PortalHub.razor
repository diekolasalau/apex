@page "/portal-hub"

<PageTitle>Portal Hub</PageTitle>

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1>Portal Hub</h1>
        <p class="text-muted mb-0">Central access point for Tutor, Carer, and Council Representative portals.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5">Tutor Portal</h3>
                    <p class="text-muted">Sign in as a tutor to view your profile and assigned students.</p>
                    <a class="btn btn-primary mt-auto" href="/tutor-portal">Open Tutor Portal</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5">Carer Portal</h3>
                    <p class="text-muted">Sign in as a carer to view students under your care.</p>
                    <a class="btn btn-primary mt-auto" href="/carer-portal">Open Carer Portal</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5">Council Representative Portal</h3>
                    <p class="text-muted">Coordinate with the centre team on student support, safeguarding, and case updates.</p>
                    <a class="btn btn-primary mt-auto" href="/council-representative-portal">Open Council Portal</a>
                </div>
            </div>
        </div>
    </div>
</div>