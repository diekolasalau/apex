@page "/carer-portal"
@using StudyMgt.Services
@using System.Globalization
@inject CarerPortalService PortalService
@inject CarerPortalSession PortalSession
@inject NavigationManager Navigation

<PageTitle>Carer Portal</PageTitle>

<div class="container mt-4">
    @if (!PortalSession.IsAuthenticated)
    {
        <h1>Carer Portal Access</h1>
        <p class="text-muted">Sign in to view students under your care.</p>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="row g-4 mt-1">
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">Sign In</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <InputText class="form-control" @bind-Value="loginUsername" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <InputText type="password" class="form-control" @bind-Value="loginPassword" />
                        </div>
                        <button class="btn btn-primary" @onclick="HandleLoginAsync">Login</button>

                        <hr class="my-4" />
                        <section id="carer-forgot-password">
                            <button class="btn btn-link px-0" type="button" @onclick="ToggleForgotPasswordPanel">
                                @(showForgotPasswordPanel ? "Hide Forgot Password" : "Forgot Password? Click here")
                            </button>

                            @if (showForgotPasswordPanel)
                            {
                                <div class="border rounded p-3 mt-2">
                                    <h3 class="h6">Forgot Password</h3>
                                    <p class="text-muted mb-2">Reset your portal password using your username and onboarding email.</p>
                                    <p class="fw-semibold mb-2">Password requirements:</p>
                                    <ul class="mb-3 ps-3">
                                        <li>Minimum 8 characters</li>
                                        <li>Must match Confirm New Password</li>
                                        <li>Use your onboarding email linked to this username</li>
                                    </ul>
                                    <div class="mb-3">
                                        <label class="form-label">Username</label>
                                        <InputText class="form-control" @bind-Value="forgotUsername" autocomplete="username" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Onboarding Email</label>
                                        <InputText class="form-control" @bind-Value="forgotEmail" type="email" autocomplete="email" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">New Password</label>
                                        <InputText type="password" class="form-control" @bind-Value="forgotNewPassword" autocomplete="new-password" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Confirm New Password</label>
                                        <InputText type="password" class="form-control" @bind-Value="forgotConfirmPassword" autocomplete="new-password" />
                                    </div>
                                    <button class="btn btn-outline-secondary" @onclick="HandleForgotPasswordAsync" disabled="@isResetInProgress">
                                        @(isResetInProgress ? "Resetting..." : "Reset Password")
                                    </button>
                                </div>
                            }
                        </section>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1>Carer Portal</h1>
                <p class="text-muted mb-0">Welcome, @PortalSession.CarerName (@PortalSession.Username)</p>
            </div>
            <button class="btn btn-outline-secondary" @onclick="Logout">Logout</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (!showPersonalInfoPanel)
        {
            <button class="btn btn-link px-0 mb-3" type="button" @onclick="ShowPersonalInfoPanel">
                Personal Info
            </button>
        }

        @if (showPersonalInfoPanel)
        {
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>My Personal Information</span>
                    <button class="btn btn-sm btn-link p-0" type="button" @onclick="HidePersonalInfoPanel">Close</button>
                </div>
                <div class="card-body">
                    @if (profile is null)
                    {
                        <div class="alert alert-secondary mb-0">No personal profile details are currently available.</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name</label>
                                <InputText class="form-control" @bind-Value="profile.FirstName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name</label>
                                <InputText class="form-control" @bind-Value="profile.LastName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" type="email" @bind-Value="profile.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <InputText class="form-control" @bind-Value="profile.PhoneNumber" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Address</label>
                                <InputText class="form-control" @bind-Value="profile.Address" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Preferred Contact Method</label>
                                <InputText class="form-control" @bind-Value="profile.PreferredContactMethod" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Emergency Contact Name</label>
                                <InputText class="form-control" @bind-Value="profile.EmergencyContactName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Emergency Contact Phone</label>
                                <InputText class="form-control" @bind-Value="profile.EmergencyContactPhone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Emergency Contact Relationship</label>
                                <InputText class="form-control" @bind-Value="profile.EmergencyContactRelationship" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-primary" @onclick="SaveProfileAsync">Save Personal Information</button>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">Students Under Your Care</div>
            <div class="card-body">
                @if (managedStudents.Count == 0)
                {
                    <div class="alert alert-secondary mb-0">No students are currently linked to your carer profile.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Student First Name</th>
                                    <th>Student Last Name</th>
                                    <th>Date of Birth</th>
                                    <th>Relationship</th>
                                    <th>EHCP Status</th>
                                    <th>Carer Status</th>
                                    <th>Student Onboarding</th>
                                    <th>Assigned Tutor(s)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in managedStudents)
                                {
                                    <tr>
                                        <td>
                                            <InputText class="form-control" @bind-Value="student.StudentFirstName" />
                                        </td>
                                        <td>
                                            <InputText class="form-control" @bind-Value="student.StudentLastName" />
                                        </td>
                                        <td>
                                            <InputDate class="form-control" @bind-Value="student.StudentDateOfBirth" />
                                        </td>
                                        <td>
                                            <InputText class="form-control" @bind-Value="student.Relationship" />
                                        </td>
                                        <td>
                                            <InputText class="form-control" @bind-Value="student.EHCPStatus" />
                                        </td>
                                        <td>@student.CarerStatus</td>
                                        <td>@(student.StudentOnboardingStatus ?? "Not found")</td>
                                        <td>@(string.IsNullOrWhiteSpace(student.AssignedTutorName) ? "Unassigned" : student.AssignedTutorName)</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveStudentAsync(student)">Save</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Student Holiday / Off-Day Booking</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadStudentTimeOffBookingsAsync" disabled="@isStudentTimeOffLoading">
                    @(isStudentTimeOffLoading ? "Refreshing..." : "Refresh")
                </button>
            </div>
            <div class="card-body">
                @if (managedStudents.Count == 0)
                {
                    <div class="alert alert-secondary mb-0">No student records are available for booking yet.</div>
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Student</label>
                            <InputSelect class="form-select" @bind-Value="selectedCarerOnboardingIdForTimeOff">
                                @foreach (var student in managedStudents)
                                {
                                    <option value="@student.CarerOnboardingId">@GetStudentOptionLabel(student)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Type</label>
                            <InputSelect class="form-select" @bind-Value="studentTimeOffRequestType">
                                <option value="Holiday">Holiday</option>
                                <option value="Off Day">Off Day</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Start Date</label>
                            <InputDate class="form-control" @bind-Value="studentTimeOffStartDate" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">End Date</label>
                            <InputDate class="form-control" @bind-Value="studentTimeOffEndDate" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-primary w-100" @onclick="SubmitStudentTimeOffBookingAsync" disabled="@isStudentTimeOffSubmitting">
                                @(isStudentTimeOffSubmitting ? "Submitting..." : "Book")
                            </button>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Reason</label>
                            <InputTextArea class="form-control" @bind-Value="studentTimeOffReason" rows="3" placeholder="State why this holiday/off-day request is needed for the student." />
                        </div>
                    </div>

                    <hr class="my-4" />

                    @if (studentTimeOffBookings.Count == 0)
                    {
                        <div class="alert alert-secondary mb-0">No student holiday/off-day requests submitted yet.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Requested (UTC)</th>
                                        <th>Student</th>
                                        <th>Type</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Days</th>
                                        <th>Status</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in studentTimeOffBookings)
                                    {
                                        <tr>
                                            <td>@booking.RequestedAtUtc.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture)</td>
                                            <td>@booking.StudentDisplayName</td>
                                            <td>@booking.RequestType</td>
                                            <td>@booking.StartDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</td>
                                            <td>@booking.EndDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</td>
                                            <td>@booking.TotalDays</td>
                                            <td>
                                                <span class="badge @(booking.ApprovalStatus == "Approved" ? "text-bg-success" : booking.ApprovalStatus == "Rejected" ? "text-bg-danger" : "text-bg-warning")">
                                                    @booking.ApprovalStatus
                                                </span>
                                            </td>
                                            <td>@booking.Reason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private string? loginUsername;
    private string? loginPassword;

    private string? forgotUsername;
    private string? forgotEmail;
    private string? forgotNewPassword;
    private string? forgotConfirmPassword;

    private List<CarerPortalStudentView> students = new();
    private CarerPersonalProfileView? profile;
    private List<CarerManagedStudentView> managedStudents = new();
    private List<CarerStudentTimeOffBookingView> studentTimeOffBookings = new();
    private string? successMessage;
    private string? errorMessage;
    private bool isResetInProgress;
    private bool showForgotPasswordPanel;
    private bool showPersonalInfoPanel;
    private bool isStudentTimeOffLoading;
    private bool isStudentTimeOffSubmitting;
    private string studentTimeOffRequestType = "Holiday";
    private DateTime studentTimeOffStartDate = DateTime.Today;
    private DateTime studentTimeOffEndDate = DateTime.Today;
    private string? studentTimeOffReason;
    private int selectedCarerOnboardingIdForTimeOff;

    protected override async Task OnInitializedAsync()
    {
        if (PortalSession.IsAuthenticated)
        {
            await LoadPortalDataAsync();
        }
    }

    private async Task HandleLoginAsync()
    {
        ClearMessages();

        var result = await PortalService.LoginAsync(loginUsername ?? string.Empty, loginPassword ?? string.Empty);
        if (!result.Success)
        {
            errorMessage = result.Message;
            return;
        }

        PortalSession.SignIn(result.CarerId ?? string.Empty, result.CarerName ?? string.Empty, result.Username ?? string.Empty);
        await LoadPortalDataAsync();
    }

    private async Task HandleForgotPasswordAsync()
    {
        ClearMessages();

        if (!string.Equals(forgotNewPassword, forgotConfirmPassword, StringComparison.Ordinal))
        {
            errorMessage = "New password and confirmation password do not match.";
            return;
        }

        isResetInProgress = true;

        try
        {
            var result = await PortalService.ResetPasswordAsync(
                forgotUsername ?? string.Empty,
                forgotEmail ?? string.Empty,
                forgotNewPassword ?? string.Empty);

            if (!result.Success)
            {
                errorMessage = result.Message;
                return;
            }

            forgotNewPassword = null;
            forgotConfirmPassword = null;
            successMessage = result.Message;
        }
        finally
        {
            isResetInProgress = false;
        }
    }

    private void ToggleForgotPasswordPanel()
    {
        showForgotPasswordPanel = !showForgotPasswordPanel;
    }

    private void ShowPersonalInfoPanel()
    {
        showPersonalInfoPanel = true;
    }

    private void HidePersonalInfoPanel()
    {
        showPersonalInfoPanel = false;
    }

    private async Task LoadPortalDataAsync()
    {
        try
        {
            profile = await PortalService.GetPersonalProfileAsync(PortalSession.CarerId ?? string.Empty);
            students = await PortalService.GetStudentsUnderCareAsync(PortalSession.CarerId ?? string.Empty);
            managedStudents = await PortalService.GetManagedStudentsAsync(PortalSession.CarerId ?? string.Empty);

            if (selectedCarerOnboardingIdForTimeOff <= 0)
            {
                selectedCarerOnboardingIdForTimeOff = managedStudents
                    .Select(s => s.CarerOnboardingId)
                    .FirstOrDefault();
            }

            await LoadStudentTimeOffBookingsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load students: {ex.Message}";
        }
    }

    private async Task SaveProfileAsync()
    {
        ClearMessages();

        if (profile is null)
        {
            errorMessage = "No profile record available to update.";
            return;
        }

        var result = await PortalService.UpdatePersonalProfileAsync(PortalSession.CarerId ?? string.Empty, profile);
        if (!result.Success)
        {
            errorMessage = result.Message;
            return;
        }

        PortalSession.SignIn(PortalSession.CarerId ?? string.Empty, $"{profile.FirstName} {profile.LastName}".Trim(), PortalSession.Username ?? string.Empty);
        successMessage = result.Message;
        await LoadPortalDataAsync();
    }

    private async Task SaveStudentAsync(CarerManagedStudentView student)
    {
        ClearMessages();

        var result = await PortalService.UpdateManagedStudentAsync(PortalSession.CarerId ?? string.Empty, student);
        if (!result.Success)
        {
            errorMessage = result.Message;
            return;
        }

        successMessage = result.Message;
        await LoadPortalDataAsync();
    }

    private async Task LoadStudentTimeOffBookingsAsync()
    {
        if (!PortalSession.IsAuthenticated)
        {
            studentTimeOffBookings.Clear();
            return;
        }

        isStudentTimeOffLoading = true;
        try
        {
            studentTimeOffBookings = await PortalService.GetStudentTimeOffBookingsAsync(
                PortalSession.CarerId ?? string.Empty,
                PortalSession.Username ?? string.Empty,
                60);
        }
        catch
        {
            studentTimeOffBookings.Clear();
        }
        finally
        {
            isStudentTimeOffLoading = false;
        }
    }

    private async Task SubmitStudentTimeOffBookingAsync()
    {
        ClearMessages();

        if (selectedCarerOnboardingIdForTimeOff <= 0)
        {
            errorMessage = "Select a student for this booking.";
            return;
        }

        var selectedStudent = managedStudents.FirstOrDefault(s => s.CarerOnboardingId == selectedCarerOnboardingIdForTimeOff);
        if (selectedStudent is null)
        {
            errorMessage = "Select a student for this booking.";
            return;
        }

        isStudentTimeOffSubmitting = true;
        try
        {
            var studentDisplayName = GetStudentOptionLabel(selectedStudent);
            var result = await PortalService.SubmitStudentTimeOffBookingAsync(
                PortalSession.CarerId ?? string.Empty,
                PortalSession.Username ?? string.Empty,
                new CarerStudentTimeOffBookingCreateModel
                {
                    CarerOnboardingId = selectedStudent.CarerOnboardingId,
                    StudentIdentifier = selectedStudent.StudentIdentifier,
                    StudentDisplayName = studentDisplayName,
                    RequestType = studentTimeOffRequestType,
                    StartDate = studentTimeOffStartDate,
                    EndDate = studentTimeOffEndDate,
                    Reason = studentTimeOffReason ?? string.Empty
                });

            if (!result.Success)
            {
                errorMessage = result.Message;
                return;
            }

            successMessage = result.Message;
            studentTimeOffReason = null;
            await LoadStudentTimeOffBookingsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to submit student booking: {ex.Message}";
        }
        finally
        {
            isStudentTimeOffSubmitting = false;
        }
    }

    private static string GetStudentOptionLabel(CarerManagedStudentView student)
    {
        return $"{student.StudentFirstName} {student.StudentLastName}".Trim();
    }

    private void ClearMessages()
    {
        successMessage = null;
        errorMessage = null;
    }

    private void Logout()
    {
        PortalSession.SignOut();
        students.Clear();
        profile = null;
        managedStudents.Clear();
        studentTimeOffBookings.Clear();
        selectedCarerOnboardingIdForTimeOff = 0;
        studentTimeOffReason = null;
        ClearMessages();
    }
}
