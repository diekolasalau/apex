@page "/onboarding"

<PageTitle>Onboarding</PageTitle>

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1>Onboarding</h1>
        <p class="text-muted mb-0">Central onboarding entry point for tutor onboarding and administrator-managed student intake.</p>
    </div>

    <div class="alert alert-info d-flex justify-content-between align-items-center" role="alert">
        <span>Already started an onboarding form?</span>
        <a class="btn btn-sm btn-primary" href="/onboarding/continue">Continue Saved Application</a>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5">Student Onboarding</h3>
                    <p class="text-muted">Student onboarding is completed by centre administrators using the secure admin dashboard.</p>
                    <a class="btn btn-outline-primary mt-auto" href="/centre-administrators">Go to Centre Administrator Access</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h3 class="h5">Tutor Onboarding</h3>
                    <p class="text-muted">Complete tutor onboarding including qualifications, DBS, and contract details.</p>
                    <a class="btn btn-primary mt-auto" href="/tutor-onboarding">Start Tutor Onboarding</a>
                </div>
            </div>
        </div>
    </div>
</div>