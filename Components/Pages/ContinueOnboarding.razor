@page "/onboarding/continue"
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Continue Onboarding</PageTitle>

<div class="container mt-4">
    <div class="mb-4">
        <h1>Continue Saved Onboarding</h1>
        <p class="text-muted mb-0">Resume a previously saved onboarding draft on this device.</p>
    </div>

    @if (!isDraftStateLoaded)
    {
        <div class="alert alert-secondary">Checking saved drafts...</div>
    }
    else
    {
        @if (!hasStudentDraft && !hasTutorDraft)
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center" role="alert">
                <span>No saved onboarding drafts were found.</span>
                <a class="btn btn-sm btn-primary" href="/onboarding">Start a New Onboarding</a>
            </div>
        }

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">Student Onboarding</h2>
                        <p class="text-muted">Resume a saved administrator-managed student onboarding draft.</p>
                        <div class="small mb-3">Status: <strong>@(hasStudentDraft ? "Draft Available" : "No Draft")</strong></div>
                        <div class="d-flex gap-2 mt-auto">
                            <button class="btn btn-primary flex-grow-1" @onclick="ContinueStudentOnboarding" disabled="@(!hasStudentDraft)">Continue In Admin Flow</button>
                            <button class="btn btn-outline-danger" @onclick="(() => ClearDraftAsync(StudentDraftKey))" disabled="@(!hasStudentDraft)">Clear</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">Tutor Onboarding</h2>
                        <p class="text-muted">Resume your saved tutor application.</p>
                        <div class="small mb-3">Status: <strong>@(hasTutorDraft ? "Draft Available" : "No Draft")</strong></div>
                        <div class="d-flex gap-2 mt-auto">
                            <button class="btn btn-primary flex-grow-1" @onclick="ContinueTutorOnboarding" disabled="@(!hasTutorDraft)">Continue</button>
                            <button class="btn btn-outline-danger" @onclick="(() => ClearDraftAsync(TutorDraftKey))" disabled="@(!hasTutorDraft)">Clear</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string StudentDraftKey = "onboarding:student:draft";
    private const string TutorDraftKey = "onboarding:tutor:draft";

    private bool isDraftStateLoaded;
    private bool hasStudentDraft;
    private bool hasTutorDraft;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await RefreshDraftStateAsync();
    }

    private async Task RefreshDraftStateAsync()
    {
        hasStudentDraft = await HasDraftAsync(StudentDraftKey);
        hasTutorDraft = await HasDraftAsync(TutorDraftKey);
        isDraftStateLoaded = true;
        StateHasChanged();
    }

    private async Task<bool> HasDraftAsync(string key)
    {
        var payload = await JS.InvokeAsync<string?>("onboardingDrafts.load", key);
        return !string.IsNullOrWhiteSpace(payload);
    }

    private void ContinueTo(string path)
    {
        Navigation.NavigateTo(path);
    }

    private void ContinueStudentOnboarding()
    {
        ContinueTo("/student-onboarding");
    }

    private void ContinueTutorOnboarding()
    {
        ContinueTo("/tutor-onboarding");
    }

    private async Task ClearDraftAsync(string key)
    {
        await JS.InvokeVoidAsync("onboardingDrafts.clear", key);
        await RefreshDraftStateAsync();
    }
}
