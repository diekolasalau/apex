        <section class="reports-section mt-4">
            <div class="reports-header d-flex justify-content-between align-items-center">
                <div>
                    <h2>Tutor Monthly Timesheets</h2>
                    <p class="mb-0">Automatically generated from tutor portal Begin/End attendance actions.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary" @onclick="LoadTutorTimesheetsAsync">Refresh</button>
                    <button class="btn btn-outline-secondary" @onclick="DownloadTutorTimesheetsPdf" disabled="@(tutorTimesheets.Count == 0)">PDF</button>
                    <button class="btn btn-outline-secondary" @onclick="DownloadTutorTimesheetsExcel" disabled="@(tutorTimesheets.Count == 0)">Excel</button>
                </div>
            </div>

            @if (attendanceMonthSummaries.Count > 0)
            {
                <div class="admin-card mt-3">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <h3 class="mb-1">Attendance Snapshot</h3>
                            <p class="text-muted mb-0">Monthly attendance activity generated from recorded Begin and End actions.</p>
                        </div>
                        <span class="badge text-bg-light">@attendanceMonthSummaries.Count month@(attendanceMonthSummaries.Count == 1 ? string.Empty : "s")</span>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <div class="kpi-card h-100">
                                <h3>Current Month Sessions</h3>
                                <p class="kpi-value">@currentMonthSessionCount</p>
                                <p class="kpi-sub">All tutors combined</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="kpi-card h-100">
                                <h3>Current Month Hours</h3>
                                <p class="kpi-value">@currentMonthTotalHours</p>
                                <p class="kpi-sub">From closed lecture attendance</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="kpi-card h-100">
                                <h3>Most Recent Month</h3>
                                <p class="kpi-value">@mostRecentAttendanceMonthLabel</p>
                                <p class="kpi-sub">Latest generated monthly summary</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h4 class="mb-3">Attendance Trend</h4>
                        <svg viewBox="0 0 760 220" class="attendance-chart" role="img" aria-label="Tutor attendance trend chart">
                            @{
                                var chartBottom = 182;
                                var chartTop = 28;
                                var chartHeight = chartBottom - chartTop;
                                var axisColor = "#97a6b7";
                            }
                            @foreach (var bar in attendanceChartBars)
                            {
                                <rect x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height" rx="10" fill="@bar.Fill" />
                            }
                            <line x1="20" y1="@chartTop" x2="20" y2="@chartBottom" stroke="@axisColor" stroke-width="2" />
                            <line x1="20" y1="@chartBottom" x2="740" y2="@chartBottom" stroke="@axisColor" stroke-width="2" />
                        </svg>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <div class="d-inline-flex align-items-center gap-2 me-3">
                                <span class="attendance-legend-box" style="background:#0d6efd;"></span>
                                <span class="small text-muted">Current month</span>
                            </div>
                            <div class="d-inline-flex align-items-center gap-2">
                                <span class="attendance-legend-box" style="background:#1f6f8b;"></span>
                                <span class="small text-muted">Earlier month</span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var bar in attendanceChartBars)
                            {
                                <div class="attendance-month-pill @(bar.IsCurrentMonth ? "is-current" : string.Empty)">
                                    <div class="attendance-month-label">@bar.MonthLabel @bar.SessionCount sessions</div>
                                    <div class="attendance-month-meta">@bar.TotalHours.ToString("0.0", CultureInfo.InvariantCulture) hours</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="reports-table-wrap mt-3">
                @if (tutorTimesheets.Count == 0)
                {
                    <p class="text-muted mb-0">No tutor timesheets generated yet.</p>
                }
                else
                {
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Tutor</th>
                                <th scope="col">Username</th>
                                <th scope="col">Month</th>
                                <th scope="col">Sessions</th>
                                <th scope="col">Total Hours</th>
                                <th scope="col">Generated (UTC)</th>
                                <th scope="col">Export</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in tutorTimesheets)
                            {
                                <tr>
                                    <td>@item.TutorName</td>
                                    <td>@item.Username</td>
                                    <td>@(new DateTime(item.Year, item.Month, 1).ToString("MMM yyyy", CultureInfo.InvariantCulture))</td>
                                    <td>@item.SessionCount</td>
                                    <td>@item.TotalHours</td>
                                    <td>@item.GeneratedAtUtc.ToString("dd MMM yyyy HH:mm:ss", CultureInfo.InvariantCulture)</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadTutorTimesheetPdf(item.TutorOnboardingId, item.Year, item.Month)">PDF</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadTutorTimesheetExcel(item.TutorOnboardingId, item.Year, item.Month)">Excel</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </section>
    }
</div>

@code {
    private string? username;
    private string? password;
    private string? errorMessage;
    private string? onboardingSuccessMessage;
    private bool isLoggingIn = false;
    private List<StudentOnboardingData> allStudents = new();
    private List<TutorOnboardingData> allTutors = new();
    private List<CarerOnboardingData> allCarers = new();
    private List<StudentOnboardingData> pendingStudents = new();
    private List<TutorOnboardingData> pendingTutors = new();
    private List<ReportRow> reportRows = new();
    private List<SubmissionReportItem> latestSubmissions = new();
    private List<SubmissionReportItem> filteredSubmissions = new();
    private List<CouncilRequestService.CouncilRequestListItem> councilRequests = new();
    private List<TutorTimeOffApprovalQueueItem> tutorTimeOffRequests = new();
    private List<CarerStudentTimeOffApprovalQueueItem> carerStudentTimeOffRequests = new();
    private CouncilRequestService.CouncilRequestListItem? selectedCouncilRequest;
    private TutorTimeOffApprovalQueueItem? selectedTutorTimeOffRequest;
    private CarerStudentTimeOffApprovalQueueItem? selectedCarerStudentTimeOffRequest;
    private List<AttendanceMonthSummary> attendanceMonthSummaries = new();
    private List<AttendanceChartBar> attendanceChartBars = new();
    private HashSet<string> reviewedCouncilRequestKeys = new(StringComparer.OrdinalIgnoreCase);
    private string? councilRequestDecisionMessage;
    private bool isSavingCouncilRequestDecision;
    private string? councilDecisionReason;
    private string? additionalAdminFullName;
    private string? additionalAdminEmail;
    private string? additionalAdminUsername;
    private string? additionalAdminPassword;
    private string selectedUserCreationType = "Admin";
    private string? additionalAccountReferenceId;
    private string? adminUserManagementMessage;
    private bool isCreatingAdditionalAdminUser;
    private bool isSavingTimeOffDecision;
    private string? timeOffDecisionMessage;
    private string? timeOffReviewNotes;
    private bool isSavingCarerTimeOffDecision;
    private string? carerTimeOffDecisionMessage;
    private string? carerTimeOffReviewNotes;
    private const int SubmissionBatchSize = 10;
    private const int CouncilRequestPageSize = 5;
    private int submissionBatchPage = 1;
    private int councilRequestPage = 1;
    private string councilRequestStatusFilter = "All";
    private List<TutorMonthlyTimesheetView> tutorTimesheets = new();
    private int currentMonthSessionCount;
    private double currentMonthTotalHours;
    private string mostRecentAttendanceMonthLabel = "-";
    private bool showReportsPanel;
    private string? selectedSubmissionTitle;
    private string? selectedSubmissionSubtitle;
    private List<SubmissionDetailField> selectedSubmissionDetails = new();
    private List<StudentChecklistItem> selectedStudentChecklist = new();
    private string selectedStudentAdultLabel = string.Empty;
    private string? selectedSubmissionCohort;
    private string? selectedSubmissionRecordId;
    private bool isEditingSelectedSubmission;
    private bool isSavingSelectedSubmission;
    private string? selectedSubmissionEditMessage;
    private StudentSubmissionEditModel studentEdit = new();
    private TutorSubmissionEditModel tutorEdit = new();
    private CarerSubmissionEditModel carerEdit = new();
    private int totalSubmissions;
    private int overallApprovalRate;
    private int overduePendingCount;
    private int TotalSubmissionPages => Math.Max(1, (int)Math.Ceiling(filteredSubmissions.Count / (double)SubmissionBatchSize));
    private int SubmissionStartIndex => filteredSubmissions.Any() ? ((submissionBatchPage - 1) * SubmissionBatchSize) + 1 : 0;
    private int SubmissionEndIndex => Math.Min(submissionBatchPage * SubmissionBatchSize, filteredSubmissions.Count);
    private List<CouncilRequestService.CouncilRequestListItem> FilteredCouncilRequests
    {
        get
        {
            if (string.Equals(councilRequestStatusFilter, "All", StringComparison.OrdinalIgnoreCase))
            {
                return councilRequests;
            }

            return councilRequests
                .Where(request => string.Equals(GetCouncilRequestStatusText(request), councilRequestStatusFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }
    private int TotalCouncilRequestPages => Math.Max(1, (int)Math.Ceiling(FilteredCouncilRequests.Count / (double)CouncilRequestPageSize));
    private int CouncilRequestStartIndex => FilteredCouncilRequests.Any() ? ((councilRequestPage - 1) * CouncilRequestPageSize) + 1 : 0;
    private int CouncilRequestEndIndex => Math.Min(councilRequestPage * CouncilRequestPageSize, FilteredCouncilRequests.Count);
    private IEnumerable<CouncilRequestService.CouncilRequestListItem> PagedCouncilRequests
    {
        get
        {
            if (councilRequestPage > TotalCouncilRequestPages)
            {
                councilRequestPage = TotalCouncilRequestPages;
            }

            if (councilRequestPage < 1)
            {
                councilRequestPage = 1;
            }

            return FilteredCouncilRequests
                .Skip((councilRequestPage - 1) * CouncilRequestPageSize)
                .Take(CouncilRequestPageSize);
        }
    }
    private IEnumerable<SubmissionReportItem> PagedFilteredSubmissions
    {
        get
        {
            if (submissionBatchPage > TotalSubmissionPages)
            {
                submissionBatchPage = TotalSubmissionPages;
            }

            if (submissionBatchPage < 1)
            {
                submissionBatchPage = 1;
            }

            return filteredSubmissions
                .Skip((submissionBatchPage - 1) * SubmissionBatchSize)
                .Take(SubmissionBatchSize);
        }
    }
    
    // Filter state variables
    private string filterStatus = "";
    private string filterCohort = "";
    private DateTime? filterFromDate = null;
    private DateTime? filterToDate = null;
    
    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        showReportsPanel = string.Equals(uri.Fragment, "#reports", StringComparison.OrdinalIgnoreCase);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["onboardingSuccess"] == "true")
        {
            onboardingSuccessMessage = "Student onboarding recorded successfully.";
            StateHasChanged();
        }
        if (AdminSession.IsAuthenticated)
        {
            await LoadPendingSubmissionsAsync();
        }
    }

    private async Task LoginAsync()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Username and password are required.";
            return;
        }

        isLoggingIn = true;

        try
        {
            var (success, message) = await AdminAccess.AuthenticateAsync(username, password);

            if (!success)
            {
                await AuditLog.LogAsync(
                    eventType: "Security",
                    action: "CentreAdminLoginFailed",
                    pagePath: "/centre-administrators",
                    actorRole: "CentreAdmin",
                    actorUsername: username,
                    success: false,
                    details: message ?? "Invalid centre admin credentials provided.");

                errorMessage = message ?? "Invalid administrator credentials.";
                return;
            }

            // Get the admin account to store in session
            var admin = await AdminAccess.GetAdminByUsernameAsync(username);
            if (admin != null)
            {
                AdminSession.SignIn(username, admin.Id, admin.Email, admin.FullName);
                await AuditLog.LogAsync(
                    eventType: "Security",
                    action: "CentreAdminLoginSucceeded",
                    pagePath: "/centre-administrators",
                    actorRole: "CentreAdmin",
                    actorUsername: AdminSession.Username,
                    success: true,
                    details: "Centre administrator signed in.");

                password = null;
                await LoadPendingSubmissionsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred during sign in. Please try again.";
            await AuditLog.LogAsync(
                eventType: "Security",
                action: "CentreAdminLoginError",
                pagePath: "/centre-administrators",
                actorRole: "CentreAdmin",
                actorUsername: username,
                success: false,
                details: $"Login error: {ex.Message}");
        }
        finally
        {
            isLoggingIn = false;
        }
    }

    private async Task Logout()
    {
        await AuditLog.LogAsync(
            eventType: "Security",
            action: "CentreAdminLogout",
            pagePath: "/centre-administrators",
            actorRole: "CentreAdmin",
            actorUsername: AdminSession.Username,
            success: true,
            details: "Centre administrator signed out.");

        AdminSession.SignOut();
        allStudents.Clear();
        allTutors.Clear();
        allCarers.Clear();
        pendingStudents.Clear();
        pendingTutors.Clear();
        reportRows.Clear();
        latestSubmissions.Clear();
        filteredSubmissions.Clear();
        councilRequests.Clear();
        tutorTimeOffRequests.Clear();
        carerStudentTimeOffRequests.Clear();
        selectedCouncilRequest = null;
        selectedTutorTimeOffRequest = null;
        selectedCarerStudentTimeOffRequest = null;
        reviewedCouncilRequestKeys.Clear();
        councilRequestDecisionMessage = null;
        councilDecisionReason = null;
        councilRequestPage = 1;
        tutorTimesheets.Clear();
        selectedStudentChecklist.Clear();
        selectedStudentAdultLabel = string.Empty;
        ClearSelectedSubmission();
        totalSubmissions = 0;
        overallApprovalRate = 0;
        overduePendingCount = 0;
        username = null;
        password = null;
        errorMessage = null;
    }

    private async Task LoadPendingSubmissionsAsync()
    {
        allStudents = (await StudentService.GetAllOnboardingsAsync()).ToList();
        allTutors = (await TutorService.GetAllOnboardingsAsync()).ToList();
        allCarers = (await CarerService.GetAllOnboardingsAsync()).ToList();

        pendingStudents = allStudents
            .Where(s => s.Status == OnboardingStatus.Pending)
            .ToList();
        pendingTutors = allTutors
            .Where(t => t.Status == OnboardingStatus.Pending)
            .ToList();

        await LoadCouncilRequestsAsync();
        BuildReports();
        await LoadTutorTimeOffRequestsAsync();
        await LoadCarerStudentTimeOffRequestsAsync();
        await LoadTutorTimesheetsAsync();
    }

    private async Task LoadCouncilRequestsAsync()
    {
        councilRequests = (await CouncilRequests.GetRecentRequestsAsync(100))
            .OrderBy(request => request.ApprovalStatus switch
            {
                "Pending" => 0,
                "Reviewed" => 1,
                "Declined" => 2,
                "Approved" => 3,
                _ => 4
            })
            .ThenByDescending(request => request.ReceivedAtUtc)
            .ToList();
        reviewedCouncilRequestKeys = councilRequests
            .Where(request => string.Equals(request.ApprovalStatus, "Reviewed", StringComparison.OrdinalIgnoreCase) ||
                              string.Equals(request.ApprovalStatus, "Approved", StringComparison.OrdinalIgnoreCase) ||
                              string.Equals(request.ApprovalStatus, "Declined", StringComparison.OrdinalIgnoreCase))
            .Select(BuildCouncilRequestKey)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (councilRequestPage > TotalCouncilRequestPages)
        {
            councilRequestPage = TotalCouncilRequestPages;
        }

        if (councilRequestPage < 1)
        {
            councilRequestPage = 1;
        }

        if (selectedCouncilRequest is not null)
        {
            var selectedKey = BuildCouncilRequestKey(selectedCouncilRequest);
            selectedCouncilRequest = councilRequests.FirstOrDefault(r => BuildCouncilRequestKey(r) == selectedKey);
        }
    }

    private void GoToPreviousCouncilRequestPage()
    {
        if (councilRequestPage > 1)
        {
            councilRequestPage--;
        }
    }

    private void OnCouncilRequestStatusFilterChanged()
    {
        councilRequestPage = 1;

        if (selectedCouncilRequest is not null)
        {
            var selectedKey = BuildCouncilRequestKey(selectedCouncilRequest);
            if (!FilteredCouncilRequests.Any(request => BuildCouncilRequestKey(request) == selectedKey))
            {
                selectedCouncilRequest = null;
            }
        }
    }

    private void GoToNextCouncilRequestPage()
    {
        if (councilRequestPage < TotalCouncilRequestPages)
        {
            councilRequestPage++;
        }
    }

    private async Task PromptAndAcceptCouncilRequestAsync(CouncilRequestService.CouncilRequestListItem? request)
    {
        if (request is null)
        {
            councilRequestDecisionMessage = "Select a valid council request first.";
            return;
        }

        await AcceptCouncilRequestAsync(request);
    }

    private async Task AcceptCouncilRequestAsync(CouncilRequestService.CouncilRequestListItem request, string? notes = null)
    {
        SetSelectedCouncilRequest(request);

        if (isSavingCouncilRequestDecision || request.RequestLogId <= 0)
        {
            return;
        }

        if (IsCouncilRequestDeclined(request))
        {
            councilRequestDecisionMessage = "Declined requests cannot be accepted.";
            return;
        }

        isSavingCouncilRequestDecision = true;
        try
        {
            var reviewer = string.IsNullOrWhiteSpace(AdminSession.Username)
                ? "centre-admin"
                : AdminSession.Username;

            var result = await CouncilRequests.ApproveRequestAsync(request.RequestLogId, reviewer, councilDecisionReason);
            councilRequestDecisionMessage = result.Message;

            if (!result.Success)
            {
                return;
            }

            reviewedCouncilRequestKeys.Add(BuildCouncilRequestKey(request));
            await LoadCouncilRequestsAsync();
            if (selectedCouncilRequest is not null)
            {
                var selectedKey = BuildCouncilRequestKey(selectedCouncilRequest);
                SetSelectedCouncilRequest(councilRequests.FirstOrDefault(r => BuildCouncilRequestKey(r) == selectedKey));
            }
        }
        finally
        {
            isSavingCouncilRequestDecision = false;
        }
    }

    private async Task PromptAndDeclineCouncilRequestAsync(CouncilRequestService.CouncilRequestListItem? request)
    {
        if (request is null)
        {
            councilRequestDecisionMessage = "Select a valid council request first.";
            return;
        }

        await DeclineCouncilRequestAsync(request);
    }

    private async Task DeclineCouncilRequestAsync(CouncilRequestService.CouncilRequestListItem request, string? notes = null)
    {
        SetSelectedCouncilRequest(request);

        if (isSavingCouncilRequestDecision || request.RequestLogId <= 0)
        {
            return;
        }

        if (IsCouncilRequestApproved(request))
        {
            councilRequestDecisionMessage = "Accepted requests cannot be declined.";
            return;
        }

        isSavingCouncilRequestDecision = true;
        try
        {
            var reviewer = string.IsNullOrWhiteSpace(AdminSession.Username)
                ? "centre-admin"
                : AdminSession.Username;

            var result = await CouncilRequests.DeclineRequestAsync(request.RequestLogId, reviewer, councilDecisionReason);
            councilRequestDecisionMessage = result.Message;

            if (!result.Success)
            {
                return;
            }

            reviewedCouncilRequestKeys.Add(BuildCouncilRequestKey(request));
            await LoadCouncilRequestsAsync();
            if (selectedCouncilRequest is not null)
            {
                var selectedKey = BuildCouncilRequestKey(selectedCouncilRequest);
                SetSelectedCouncilRequest(councilRequests.FirstOrDefault(r => BuildCouncilRequestKey(r) == selectedKey));
            }
        }
        finally
        {
            isSavingCouncilRequestDecision = false;
        }
    }

    private void ViewCouncilRequest(CouncilRequestService.CouncilRequestListItem request)
    {
        SetSelectedCouncilRequest(request);
        adminUserManagementMessage = null;
    }

    private async Task CreateUserAccountAsync()
    {
        adminUserManagementMessage = null;

        if (isCreatingAdditionalAdminUser)
        {
            return;
        }

        isCreatingAdditionalAdminUser = true;
        try
        {
            if (string.Equals(selectedUserCreationType, "Admin", StringComparison.Ordinal))
            {
                var result = await AdminAccess.CreateAdminAccountAsync(
                    additionalAdminUsername ?? string.Empty,
                    additionalAdminPassword ?? string.Empty,
                    additionalAdminEmail ?? string.Empty,
                    additionalAdminFullName ?? string.Empty);

                adminUserManagementMessage = FormatUserCreationMessage(result.message, result.success);
                if (!result.success)
                {
                    return;
                }
            }
            else if (string.Equals(selectedUserCreationType, "Tutor", StringComparison.Ordinal))
            {
                var result = await TutorPortal.RegisterAsync(
                    0,
                    additionalAdminEmail ?? string.Empty,
                    additionalAdminUsername ?? string.Empty,
                    additionalAdminPassword ?? string.Empty);

                adminUserManagementMessage = FormatUserCreationMessage(result.Message, result.Success);
                if (!result.Success)
                {
                    return;
                }
            }
            else
            {
                var result = await CarerPortal.RegisterAsync(
                    additionalAccountReferenceId ?? string.Empty,
                    additionalAdminEmail ?? string.Empty,
                    additionalAdminUsername ?? string.Empty,
                    additionalAdminPassword ?? string.Empty);

                adminUserManagementMessage = FormatUserCreationMessage(result.Message, result.Success);
                if (!result.Success)
                {
                    return;
                }
            }

            additionalAdminFullName = string.Empty;
            additionalAdminEmail = string.Empty;
            additionalAdminUsername = string.Empty;
            additionalAdminPassword = string.Empty;
            additionalAccountReferenceId = string.Empty;
        }
        catch (Exception ex)
        {
            adminUserManagementMessage = FormatUserCreationMessage(ex.Message, false);
        }
        finally
        {
            isCreatingAdditionalAdminUser = false;
        }
    }

    private static string FormatUserCreationMessage(string? message, bool isSuccess)
    {
        if (isSuccess)
        {
            return string.IsNullOrWhiteSpace(message)
                ? "Account created successfully."
                : message;
        }

        if (string.IsNullOrWhiteSpace(message))
        {
            return "Unable to create account. Please check the details and try again.";
        }

        var trimmed = message.Trim();
        const string prefix = "Unable to create account:";
        if (trimmed.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            trimmed = trimmed[prefix.Length..].Trim();
        }

        if (trimmed.Contains("could not be translated", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Contains("StringComparison", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Contains("DbSet<", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Contains("go.microsoft.com/fwlink", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to create account due to a temporary system error. Please try again in a moment.";
        }

        return trimmed;
    }

    private bool IsCouncilRequestReviewed(CouncilRequestService.CouncilRequestListItem request)
    {
        return reviewedCouncilRequestKeys.Contains(BuildCouncilRequestKey(request));
    }

    private bool IsCouncilRequestApproved(CouncilRequestService.CouncilRequestListItem request)
    {
        return string.Equals(request.ApprovalStatus, "Approved", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsCouncilRequestDeclined(CouncilRequestService.CouncilRequestListItem? request)
    {
        return request is not null && string.Equals(request.ApprovalStatus, "Declined", StringComparison.OrdinalIgnoreCase);
    }

    private string GetCouncilRequestStatusText(CouncilRequestService.CouncilRequestListItem request)
    {
        if (IsCouncilRequestApproved(request))
        {
            return "Accepted";
        }

        if (IsCouncilRequestDeclined(request))
        {
            return "Declined";
        }

        return IsCouncilRequestReviewed(request) ? "Reviewed" : "Pending";
    }

    private string GetCouncilRequestStatusCss(CouncilRequestService.CouncilRequestListItem request)
    {
        if (IsCouncilRequestApproved(request))
        {
            return "status-ok";
        }

        if (IsCouncilRequestDeclined(request))
        {
            return "status-blocked";
        }

        return IsCouncilRequestReviewed(request) ? "status-in-progress" : "status-pending";
    }

    private bool CanApproveCouncilRequest(CouncilRequestService.CouncilRequestListItem? request)
    {
        return request is not null && !IsCouncilRequestApproved(request) && !IsCouncilRequestDeclined(request);
    }

    private static string BuildCouncilRequestKey(CouncilRequestService.CouncilRequestListItem request)
    {
        return string.Join(
            "|",
            request.ReceivedAtUtc.ToString("O", CultureInfo.InvariantCulture),
            request.StudentIdentifier,
            request.RepresentativeName,
            request.CouncilName,
