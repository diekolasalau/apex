                                    <div class="col-md-6">
                                        <div class="small text-muted text-uppercase">Reviewed</div>
                                        <div>@selectedCarerStudentTimeOffRequest.ReviewedAtUtc.Value.ToString("dd MMM yyyy HH:mm:ss", CultureInfo.InvariantCulture) (UTC)</div>
                                    </div>
                                    <div class="col-md-6">
