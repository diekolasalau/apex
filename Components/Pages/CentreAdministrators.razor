@page "/centre-administrators"

@using StudyMgt.Services
@using System.Globalization
@inject StudentOnboardingService StudentService
@inject TutorOnboardingService TutorService
@inject TutorPortalService TutorPortal
@inject CarerOnboardingService CarerService
@inject CarerPortalService CarerPortal
@inject CentreAdminAccessService AdminAccess
@inject CentreAdminSession AdminSession
@inject AppAuditLogService AuditLog
@inject CouncilPortalAccessService CouncilPortalAccess
@inject CouncilRequestService CouncilRequests
@inject NavigationManager Navigation

<PageTitle>Centre Administrators</PageTitle>

<div class="admin-dashboard-container">
    @if (!AdminSession.IsAuthenticated)
    {
        <div class="admin-hero">
            <h1>Centre Administrator Access</h1>
            <p class="lead">Sign in to access onboarding controls and administrator-only workflows.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(onboardingSuccessMessage))
        {
            <div class="alert alert-success">@onboardingSuccessMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="admin-card" style="max-width: 520px; margin: 0 auto;">
            <h2>Administrator Login</h2>
            <p>Use your centre administrator credentials to continue.</p>
            <div class="mb-3">
                <label class="form-label">Username</label>
                <InputText class="form-control" @bind-Value="username" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText type="password" class="form-control" @bind-Value="password" />
            </div>
            <button class="btn btn-primary w-100 mb-2" @onclick="LoginAsync" disabled="@isLoggingIn">
                @if (isLoggingIn)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Signing In...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
            <div class="text-center">
                <a href="/password-reset-request" class="btn btn-link btn-sm">Forgot Password?</a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-start">
            <div class="admin-hero text-start mb-4">
                <h1>Centre Administrator Dashboard</h1>
                <p class="lead">Manage centre settings, user approvals, compliance oversight, and reporting from one secure place.</p>
            </div>
            <button class="btn btn-outline-secondary" @onclick="Logout">Sign Out</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <!-- Pending Submissions Summary -->
        <div class="pending-summary mb-4">
            <h2>Pending Submissions Overview</h2>
            <div class="row">
                <div class="col-md-6">
                    <div class="summary-card">
                        <h3>Students</h3>
                        <p class="count">@pendingStudents.Count</p>
                        <p>pending onboarding submissions</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="summary-card">
                        <h3>Tutors</h3>
                        <p class="count">@pendingTutors.Count</p>
                        <p>pending onboarding submissions</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-grid">
            <div class="admin-card">
                <h2>Onboarding Review</h2>
                <p>Review pending student and tutor onboarding submissions, validate details, approve registrations, and assign students to tutors.</p>
                <button class="btn btn-primary" @onclick="NavigateToAdminReview">Review Onboardings</button>
            </div>

            <div class="admin-card">
                <h2>Privileged Onboarding</h2>
                <p>Start onboarding directly on behalf of students and tutors from administrator interface.</p>
                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-primary" @onclick="NavigateToStudentOnboarding" disabled="@(!AdminSession.CanOnboardStudents)">Onboard Student</button>
                    <button class="btn btn-primary" @onclick="NavigateToTutorOnboarding" disabled="@(!AdminSession.CanOnboardTutors)">Onboard Tutor</button>
                </div>
            </div>

            <div class="admin-card">
                <h2>Compliance & Audit</h2>
                <p>Track data protection compliance, monitor audit logs, and manage consent records for UK GDPR and Ofsted readiness.</p>
                <button class="btn btn-secondary" @onclick="NavigateToCompliance">View Compliance</button>
            </div>

            <div class="admin-card">
                <h2>Reports & Attendance</h2>
                <p>Generate progress reports, attendance summaries, and SEN support plans for review by staff and parents.</p>
                <button class="btn btn-secondary" @onclick="NavigateToReportsAsync">View Reports</button>
            </div>
        </div>

        <section class="reports-section mt-4">
            <div class="reports-header d-flex justify-content-between align-items-center">
                <div>
                    <h2>User Creation</h2>
                    <p class="mb-0">Create login accounts for centre administrators, tutors, and carers.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(adminUserManagementMessage))
            {
                <div class="alert alert-info mt-3 mb-0">@adminUserManagementMessage</div>
            }

            <div class="row g-3 mt-1">
                <div class="col-md-3">
                    <label class="form-label">Account Type</label>
                    <InputSelect class="form-select" @bind-Value="selectedUserCreationType">
                        <option value="Admin">Centre Admin</option>
                        <option value="Tutor">Tutor Portal</option>
                        <option value="Carer">Carer Portal</option>
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="additionalAdminEmail" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Username</label>
                    <InputText class="form-control" @bind-Value="additionalAdminUsername" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Password</label>
                    <InputText type="password" class="form-control" @bind-Value="additionalAdminPassword" />
                    <div class="form-text">Minimum 8 characters.</div>
                </div>

                @if (string.Equals(selectedUserCreationType, "Admin", StringComparison.Ordinal))
                {
                    <div class="col-md-3">
                        <label class="form-label">Full Name</label>
                        <InputText class="form-control" @bind-Value="additionalAdminFullName" />
                    </div>
                }
                else if (string.Equals(selectedUserCreationType, "Carer", StringComparison.Ordinal))
                {
                    <div class="col-md-3">
                        <label class="form-label">Carer ID</label>
                        <InputText class="form-control" @bind-Value="additionalAccountReferenceId" />
                    </div>
                }
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-outline-primary"
                        @onclick="CreateUserAccountAsync"
                        disabled="@(isCreatingAdditionalAdminUser)">
                    @(isCreatingAdditionalAdminUser ? "Creating..." : "Create User")
                </button>
            </div>
        </section>

        @if (showReportsPanel)
        {
        <section id="reports" class="reports-section mt-4">
            <div class="reports-header d-flex justify-content-between align-items-center">
                <div>
                    <h2>Operational Reports</h2>
                    <p class="mb-0">Live onboarding reports for administrator decisions, risk management, and capacity planning.</p>
                </div>
                <button class="btn btn-outline-primary" @onclick="RefreshReportsAsync">Refresh</button>
            </div>

            <!-- Simple SVG Bar Chart Visualization -->
            <div class="my-4">
                <h4>Cohort Status Overview</h4>
                <svg width="420" height="160">
                    @{
                        var barWidth = 40;
                        var gap = 30;
                        var maxVal = reportRows.Count > 0 ? reportRows.Max(r => r.Total) : 1;
                        var yScale = 100.0 / (maxVal > 0 ? maxVal : 1);
                        var colors = new[] { "#007bff", "#28a745", "#ffc107", "#dc3545" };
                        int i = 0;
                        foreach (var row in reportRows)
                        {
                            // Pending (yellow), Approved (green), Blocked (red)
                            var x = 30 + i * (barWidth * 3 + gap);
                            <rect x="@x" y="@(120 - row.Pending * yScale)" width="@barWidth" height="@(row.Pending * yScale)" fill="#ffc107" />
                            <rect x="@(x + barWidth)" y="@(120 - row.Approved * yScale)" width="@barWidth" height="@(row.Approved * yScale)" fill="#28a745" />
                            <rect x="@(x + barWidth * 2)" y="@(120 - row.Blocked * yScale)" width="@barWidth" height="@(row.Blocked * yScale)" fill="#dc3545" />
                            // Labels (updated for SVG rendering)
                            @:<text x="@(x + barWidth)" y="140" font-size="12" text-anchor="middle">@row.Cohort</text>
                            i++;
                        }
                    }
                    <!-- Y axis -->
                    <line x1="20" y1="20" x2="20" y2="120" stroke="#333" stroke-width="2" />
                    <line x1="20" y1="120" x2="400" y2="120" stroke="#333" stroke-width="2" />
                    <!-- Legend -->
                    <rect x="320" y="10" width="12" height="12" fill="#ffc107" />
                    <text x="335" y="20" font-size="12">Pending</text>
                    <rect x="320" y="30" width="12" height="12" fill="#28a745" />
                    <text x="335" y="40" font-size="12">Approved</text>
                    <rect x="320" y="50" width="12" height="12" fill="#dc3545" />
                    <text x="335" y="60" font-size="12">Blocked</text>
                </svg>
            </div>

            <div class="reports-kpis row g-3 mt-1">
                <div class="col-md-4">
                    <div class="kpi-card">
                        <h3>Total Onboarding Submissions</h3>
                        <p class="kpi-value">@totalSubmissions</p>
                        <p class="kpi-sub">Across students, tutors, and carers</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kpi-card">
                        <h3>Approval Rate</h3>
                        <p class="kpi-value">@overallApprovalRate%</p>
                        <p class="kpi-sub">Approved records out of all submissions</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kpi-card kpi-alert">
                        <h3>Overdue Pending Reviews</h3>
                        <p class="kpi-value">@overduePendingCount</p>
                        <p class="kpi-sub">Pending for more than 7 days</p>
                    </div>
                </div>
            </div>

            <div class="reports-table-wrap mt-4">
                <h3>Pipeline Summary By Cohort</h3>
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Cohort</th>
                            <th scope="col">Total</th>
                            <th scope="col">Pending</th>
                            <th scope="col">Approved</th>
                            <th scope="col">Rejected/Suspended</th>
                            <th scope="col">Approval Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in reportRows)
                        {
                            <tr>
                                <td>@row.Cohort</td>
                                <td>@row.Total</td>
                                <td>@row.Pending</td>
                                <td>@row.Approved</td>
                                <td>@row.Blocked</td>
                                <td>@row.ApprovalRate%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="reports-table-wrap mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3>Latest Submissions</h3>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters">Clear Filters</button>
                </div>

                <!-- Filter Controls -->
                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Status</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="filterStatus">
                                    <option value="">All</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Rejected">Rejected</option>
                                    <option value="Suspended">Suspended</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Cohort</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="filterCohort">
                                    <option value="">All</option>
                                    <option value="Student">Students</option>
                                    <option value="Tutor">Tutors</option>
                                    <option value="Carer">Carers</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">From Date (UTC)</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="filterFromDate" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">To Date (UTC)</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="filterToDate" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFiltersAsync">Apply Filters</button>
                            </div>
                        </div>
                    </div>
                </div>

                @if (filteredSubmissions.Count == 0 && latestSubmissions.Count > 0)
                {
                    <p class="text-muted mb-0">No records match the selected filters.</p>
                }
                else if (latestSubmissions.Count == 0)
                {
                    <p class="text-muted mb-0">No onboarding records available yet.</p>
                }
                else
                {
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Submitted</th>
                                <th scope="col">Cohort</th>
                                <th scope="col">Name</th>
                                <th scope="col">Status</th>
                                <th scope="col">Age (days)</th>
                                <th scope="col">View</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PagedFilteredSubmissions)
                            {
                                <tr>
                                    <td>@item.SubmittedAt.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</td>
                                    <td>@item.Cohort</td>
                                    <td>@item.DisplayName</td>
                                    <td>
                                        <span class="status-chip @GetStatusCss(item.Status)">@item.Status</span>
                                    </td>
                                    <td>@item.AgeInDays</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewSubmissionDetails(item)">View</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <small class="text-muted">
                            @if (filteredSubmissions.Any())
                            {
                                <span>Showing @SubmissionStartIndex-@SubmissionEndIndex of @filteredSubmissions.Count records</span>
                            }
                            else
                            {
                                <span>No records match the selected filters.</span>
                            }
                        </small>
                        <div class="btn-group" role="group" aria-label="Submission paging">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousSubmissionPage" disabled="@(submissionBatchPage <= 1)">Previous</button>
                            <button class="btn btn-outline-secondary btn-sm" disabled>Page @submissionBatchPage of @TotalSubmissionPages</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="NextSubmissionPage" disabled="@(submissionBatchPage >= TotalSubmissionPages)">Next</button>
                        </div>
                    </div>

                    @if (selectedSubmissionDetails.Count > 0 || isEditingSelectedSubmission)
                    {
                        <div class="admin-card mt-3">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <h3 class="mb-1">@selectedSubmissionTitle</h3>
                                    <p class="text-muted mb-0">@selectedSubmissionSubtitle</p>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (!isEditingSelectedSubmission)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="BeginEditSelectedSubmission" disabled="@string.IsNullOrWhiteSpace(selectedSubmissionCohort)">Edit</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="SaveSelectedSubmissionAsync" disabled="@isSavingSelectedSubmission">
                                            @if (isSavingSelectedSubmission)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                <span>Saving...</span>
                                            }
                                            else
                                            {
                                                <span>Save</span>
                                            }
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEditSelectedSubmission" disabled="@isSavingSelectedSubmission">Cancel</button>
                                    }
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedSubmission" disabled="@isSavingSelectedSubmission">Close</button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(selectedSubmissionEditMessage))
                            {
                                <div class="alert alert-info mt-3 mb-0">@selectedSubmissionEditMessage</div>
                            }

                            @if (isEditingSelectedSubmission)
                            {
                                <div class="row g-3 mt-1">
                                    @if (selectedSubmissionCohort == "Student")
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label">First Name</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.FirstName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Last Name</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.LastName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Student ID</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.StudentId" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Date Of Birth</label>
                                            <InputDate class="form-control" @bind-Value="studentEdit.DateOfBirth" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Gender</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.Gender" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Emergency Contact</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.EmergencyContactName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Emergency Contact Phone</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.EmergencyContactPhone" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Emergency Contact Email</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.EmergencyContactEmail" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Relationship</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.RelationshipToStudent" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">SEN Indicators</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.SENIndicators" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">EHCP Status</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.EHCPStatus" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Assigned Tutor</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.AssignedTutorName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Preferred Contact Method</label>
                                            <InputText class="form-control" @bind-Value="studentEdit.PreferredContactMethod" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Admin Notes</label>
                                            <InputTextArea class="form-control" @bind-Value="studentEdit.AdminNotes" />
                                        </div>
                                    }
                                    else if (selectedSubmissionCohort == "Tutor")
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label">First Name</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.FirstName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Last Name</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.LastName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Email</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.Email" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Phone</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.Phone" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Address</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.Address" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Date Of Birth</label>
                                            <InputDate class="form-control" @bind-Value="tutorEdit.DateOfBirth" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Gender</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.Gender" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Highest Qualification</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.HighestQualification" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Teaching Experience</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.TeachingExperience" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Courses To Be Taken</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.CoursesToBeTaken" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">DBS Status</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.DBSStatus" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Right To Work</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.RightToWorkStatus" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Safeguarding Training</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.SafeguardingTrainingStatus" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Contract Type</label>
                                            <InputText class="form-control" @bind-Value="tutorEdit.ContractType" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Admin Notes</label>
                                            <InputTextArea class="form-control" @bind-Value="tutorEdit.AdminNotes" />
                                        </div>
                                    }
                                    else if (selectedSubmissionCohort == "Carer")
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label">First Name</label>
                                            <InputText class="form-control" @bind-Value="carerEdit.FirstName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Last Name</label>
                                            <InputText class="form-control" @bind-Value="carerEdit.LastName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Email</label>
                                            <InputText class="form-control" @bind-Value="carerEdit.Email" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Phone</label>
                                            <InputText class="form-control" @bind-Value="carerEdit.PhoneNumber" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Address</label>
                                            <InputText class="form-control" @bind-Value="carerEdit.Address" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Student Name</label>
                                            <InputText class="form-control" @bind-Value="carerEdit.StudentName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Student ID</label>
                                            <InputText class="form-control" @bind-Value="carerEdit.StudentId" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Relationship</label>
                                            <InputText class="form-control" @bind-Value="carerEdit.Relationship" />
                                        </div>
                                        <div class="col-md-6">
