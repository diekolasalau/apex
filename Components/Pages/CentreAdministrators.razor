                    saved = await TutorService.UpdateOnboardingAsync(tutor.Id, new TutorAdminUpdateModel
                    {
                        FirstName = tutorEdit.FirstName,
                        LastName = tutorEdit.LastName,
                        DateOfBirth = tutorEdit.DateOfBirth,
                        Gender = tutorEdit.Gender,
                        Email = tutorEdit.Email,
                        Phone = tutorEdit.Phone,
                        Address = tutorEdit.Address,
                        HighestQualification = tutorEdit.HighestQualification,
                        TeachingExperience = tutorEdit.TeachingExperience,
                        CoursesToBeTaken = tutorEdit.CoursesToBeTaken,
                        DBSStatus = tutorEdit.DBSStatus,
                        RightToWorkStatus = tutorEdit.RightToWorkStatus,
                        SafeguardingTrainingStatus = tutorEdit.SafeguardingTrainingStatus,
                        ContractType = tutorEdit.ContractType,
                        Status = tutor.Status,
                        AdminNotes = tutorEdit.AdminNotes
                    }, changedBy);
                    break;
                }
                case "Carer":
                {
                    var carer = allCarers.FirstOrDefault(c => string.Equals(c.CarerId, selectedSubmissionRecordId, StringComparison.OrdinalIgnoreCase));
                    if (carer is null)
                    {
                        selectedSubmissionEditMessage = "Carer record is no longer available.";
                        return;
                    }

                    saved = await CarerService.UpdateOnboardingAsync(carer.CarerId ?? string.Empty, new CarerAdminUpdateModel
                    {
                        FirstName = carerEdit.FirstName,
                        LastName = carerEdit.LastName,
                        Email = carerEdit.Email,
                        PhoneNumber = carerEdit.PhoneNumber,
                        Address = carerEdit.Address,
                        StudentName = carerEdit.StudentName,
                        StudentId = carerEdit.StudentId,
                        Relationship = carerEdit.Relationship,
                        EHCPStatus = carerEdit.EHCPStatus,
                        PreferredContactMethod = carerEdit.PreferredContactMethod,
                        EmergencyContactName = carerEdit.EmergencyContactName,
                        EmergencyContactPhone = carerEdit.EmergencyContactPhone,
                        Status = carer.Status,
                        ApprovalNotes = carerEdit.ApprovalNotes
                    }, changedBy);
                    break;
                }
            }

            if (!saved)
            {
                selectedSubmissionEditMessage = "Unable to save changes for the selected record.";
                return;
            }

            await LoadPendingSubmissionsAsync();
            ViewSubmissionDetails(new SubmissionReportItem(
                selectedSubmissionCohort,
                selectedSubmissionRecordId,
                string.Empty,
                string.Empty,
                DateTime.UtcNow,
                0));

            isEditingSelectedSubmission = false;
            selectedSubmissionEditMessage = "Changes saved successfully.";
        }
        catch
        {
            selectedSubmissionEditMessage = "An unexpected error occurred while saving changes.";
        }
        finally
        {
            isSavingSelectedSubmission = false;
        }
    }

    private void SetMissingSubmissionDetails(SubmissionReportItem item)
    {
        selectedSubmissionTitle = $"{item.Cohort} Details";
        selectedSubmissionSubtitle = "Record unavailable";
        selectedSubmissionDetails = new()
        {
            new("Selected Record", item.DisplayName),
            new("Status", item.Status),
            new("Submitted", item.SubmittedAt.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)),
            new("Details", "This record could not be resolved from the currently loaded cohort data.")
        };
    }

    private void ClearSelectedSubmission()
    {
        selectedSubmissionTitle = null;
        selectedSubmissionSubtitle = null;
        selectedSubmissionDetails = new();
        selectedStudentChecklist.Clear();
        selectedStudentAdultLabel = string.Empty;
        selectedSubmissionCohort = null;
        selectedSubmissionRecordId = null;
        isEditingSelectedSubmission = false;
        isSavingSelectedSubmission = false;
        selectedSubmissionEditMessage = null;
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string FormatDate(DateTime value)
    {
        return value == default ? "-" : value.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    }

    private static string GetApplicableAdultLabel(string? relationship)
    {
        if (string.IsNullOrWhiteSpace(relationship))
        {
            return "Parent / Carer / Guardian";
        }

        return relationship.Trim().ToLowerInvariant() switch
        {
            "parent" => "Parent",
            "guardian" => "Guardian",
            "carer" => "Carer",
            "parent/guardian" or "parent-guardian" => "Parent / Guardian",
            "emergency-contact" or "emergency contact" => "Emergency Contact",
            _ => relationship.Trim()
        };
    }

    private static List<StudentChecklistItem> BuildStudentChecklist(StudentOnboardingData student)
    {
        return new List<StudentChecklistItem>
        {
            new("Applicable adult contact recorded", !string.IsNullOrWhiteSpace(student.EmergencyContactName), DisplayValue(student.EmergencyContactName)),
            new("Relationship confirmed", !string.IsNullOrWhiteSpace(student.RelationshipToStudent), DisplayValue(GetApplicableAdultLabel(student.RelationshipToStudent))),
            new("Emergency phone recorded", !string.IsNullOrWhiteSpace(student.EmergencyContactPhone), DisplayValue(student.EmergencyContactPhone)),
            new("Emergency email recorded", !string.IsNullOrWhiteSpace(student.EmergencyContactEmail), DisplayValue(student.EmergencyContactEmail)),
            new("Privacy notice acknowledged", student.PrivacyNoticeAcknowledged, student.PrivacyNoticeAcknowledged ? "Acknowledged" : "Not acknowledged"),
            new("Declaration confirmed", student.DeclarationConfirmed, student.DeclarationConfirmed ? "Confirmed" : "Not confirmed"),
            new("SEN indicators captured", !string.IsNullOrWhiteSpace(student.SENIndicators), DisplayValue(student.SENIndicators)),
            new("EHCP status recorded", !string.IsNullOrWhiteSpace(student.EHCPStatus), DisplayValue(student.EHCPStatus)),
            new("Assigned tutor recorded", !string.IsNullOrWhiteSpace(student.AssignedTutorName), DisplayValue(student.AssignedTutorName)),
            new("Preferred contact method recorded", !string.IsNullOrWhiteSpace(student.PreferredContactMethod), DisplayValue(student.PreferredContactMethod))
        };
    }

    private void BuildAttendanceVisuals()
    {
        const int chartLeft = 34;
        const int chartBottom = 182;
        const int chartTop = 28;
        const int barWidth = 72;
        const int gap = 22;

        attendanceMonthSummaries = tutorTimesheets
            .GroupBy(item => new { item.Year, item.Month })
            .Select(group => new AttendanceMonthSummary(
                group.Key.Year,
                group.Key.Month,
                group.Sum(item => item.SessionCount),
                group.Sum(item => item.TotalHours)))
            .OrderByDescending(item => item.Year)
            .ThenByDescending(item => item.Month)
            .Take(6)
            .Select(item => item with { IsCurrentMonth = item.Year == DateTime.UtcNow.Year && item.Month == DateTime.UtcNow.Month })
            .ToList();

        if (attendanceMonthSummaries.Count == 0)
        {
            attendanceChartBars = new List<AttendanceChartBar>();
            currentMonthSessionCount = 0;
            currentMonthTotalHours = 0;
            mostRecentAttendanceMonthLabel = "-";
            return;
        }

        var chartHeight = chartBottom - chartTop;
        var maxSessions = Math.Max(1, attendanceMonthSummaries.Max(item => item.SessionCount));
        var scale = chartHeight / (double)maxSessions;

        attendanceChartBars = attendanceMonthSummaries
            .Select((item, index) =>
            {
                var x = chartLeft + index * (barWidth + gap);
                var barHeight = Math.Max(6, item.SessionCount * scale);
                var y = chartBottom - barHeight;

                return new AttendanceChartBar(
                    x,
                    y,
                    barWidth,
                    barHeight,
                    x + barWidth / 2,
                    y - 10,
                    item.SessionCount,
                    item.MonthLabel,
                    item.TotalHours,
                    item.IsCurrentMonth ? "#0d6efd" : "#1f6f8b",
                    item.IsCurrentMonth);
            })
            .ToList();

        currentMonthSessionCount = tutorTimesheets
            .Where(item => item.Year == DateTime.UtcNow.Year && item.Month == DateTime.UtcNow.Month)
            .Sum(item => item.SessionCount);

        currentMonthTotalHours = tutorTimesheets
            .Where(item => item.Year == DateTime.UtcNow.Year && item.Month == DateTime.UtcNow.Month)
            .Sum(item => item.TotalHours);

        var mostRecent = attendanceMonthSummaries.FirstOrDefault();
        mostRecentAttendanceMonthLabel = mostRecent is null
            ? "-"
            : new DateTime(mostRecent.Year, mostRecent.Month, 1).ToString("MMM yyyy", CultureInfo.InvariantCulture);
    }

