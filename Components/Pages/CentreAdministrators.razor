    private async Task SaveTutorTimeOffDecisionAsync(string status)
    {
        if (selectedTutorTimeOffRequest is null)
        {
            timeOffDecisionMessage = "Select a request first.";
            return;
        }

        if (IsTimeOffDecisionLocked(selectedTutorTimeOffRequest.ApprovalStatus))
        {
            timeOffDecisionMessage = "This request has already been reviewed.";
            return;
        }

        if (isSavingTimeOffDecision)
        {
            return;
        }

        isSavingTimeOffDecision = true;
        try
        {
            var reviewedBy = string.IsNullOrWhiteSpace(AdminSession.Username)
                ? "centre-admin"
                : AdminSession.Username;

            var result = await TutorPortal.UpdateTimeOffRequestStatusAsync(
                selectedTutorTimeOffRequest.RequestLogId,
                reviewedBy,
                status,
                timeOffReviewNotes);

            timeOffDecisionMessage = result.Message;
            if (!result.Success)
            {
                return;
            }

            await LoadTutorTimeOffRequestsAsync();
            if (selectedTutorTimeOffRequest is not null)
            {
                selectedTutorTimeOffRequest = tutorTimeOffRequests.FirstOrDefault(x => x.RequestLogId == selectedTutorTimeOffRequest.RequestLogId);
            }
        }
        finally
        {
            isSavingTimeOffDecision = false;
        }
    }

