    private static bool IsTimeOffDecisionLocked(string? approvalStatus)
    {
        return !string.Equals(approvalStatus, "Pending", StringComparison.OrdinalIgnoreCase);
    }

    private void BuildReports()
    {
        // Check if data has changed before recalculating
        if (allStudents == null || allTutors == null || allCarers == null)
        {
            return;
        }

        var now = DateTime.UtcNow;

        totalSubmissions = allStudents.Count + allTutors.Count;
        var approvedCount = allStudents.Count(s => s.Status == OnboardingStatus.Approved)
            + allTutors.Count(t => t.Status == OnboardingStatus.Approved);

        overallApprovalRate = totalSubmissions == 0
            ? 0
            : (int)Math.Round((double)approvedCount * 100 / totalSubmissions);

        overduePendingCount = pendingStudents.Count(s => (now - s.SubmittedDate).TotalDays > 7)
            + pendingTutors.Count(t => (now - t.SubmittedDate).TotalDays > 7);

        reportRows = new List<ReportRow>
        {
            BuildRow("Students", allStudents.Select(s => s.Status)),
            BuildRow("Tutors", allTutors.Select(t => t.Status))
        };

        latestSubmissions = allStudents
            .Select(s => new SubmissionReportItem("Student", s.Id.ToString(CultureInfo.InvariantCulture), $"{s.FirstName} {s.LastName}".Trim(), s.Status.ToString(), s.SubmittedDate, (int)Math.Max(0, (now - s.SubmittedDate).TotalDays)))
            .Concat(allTutors.Select(t => new SubmissionReportItem("Tutor", t.Id.ToString(CultureInfo.InvariantCulture), $"{t.FirstName} {t.LastName}".Trim(), t.Status.ToString(), t.SubmittedDate, (int)Math.Max(0, (now - t.SubmittedDate).TotalDays))))
            .OrderByDescending(i => i.SubmittedAt)
            .ToList();

        // Apply filters after building the base list
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        filteredSubmissions = latestSubmissions
            .Where(item =>
            {
                // Filter by status
                if (!string.IsNullOrEmpty(filterStatus) && item.Status != filterStatus)
                {
                    return false;
                }

                // Filter by cohort
                if (!string.IsNullOrEmpty(filterCohort) && !string.Equals(item.Cohort, filterCohort, StringComparison.Ordinal))
                    return false;

                // Filter by date range
                if (filterFromDate.HasValue && item.SubmittedAt < filterFromDate.Value)
                    return false;
                if (filterToDate.HasValue && item.SubmittedAt > filterToDate.Value.AddDays(1))
                    return false;

                return true;
            })
            .ToList();

            submissionBatchPage = 1;
    }

    private Task ApplyFiltersAsync()
    {
        ApplyFilters();
        return Task.CompletedTask;
    }

    private void NextSubmissionPage()
    {
        if (submissionBatchPage < TotalSubmissionPages)
        {
            submissionBatchPage++;
        }
    }

    private void PreviousSubmissionPage()
    {
        if (submissionBatchPage > 1)
        {
            submissionBatchPage--;
        }
    }

    private void ResetFilters()
    {
        filterStatus = "";
        filterCohort = "";
        filterFromDate = null;
        filterToDate = null;
        ApplyFilters();
    }

    private static ReportRow BuildRow(string cohort, IEnumerable<OnboardingStatus> statuses)
    {
        var statusList = statuses.ToList();
        var total = statusList.Count;
        var pending = statusList.Count(s => s == OnboardingStatus.Pending);
        var approved = statusList.Count(s => s == OnboardingStatus.Approved || s == OnboardingStatus.Completed);
        var blocked = statusList.Count(s => s == OnboardingStatus.Rejected || s == OnboardingStatus.Suspended);
        var approvalRate = total == 0 ? 0 : (int)Math.Round((double)approved * 100 / total);

        return new ReportRow(cohort, total, pending, approved, blocked, approvalRate);
    }

    private static string GetStatusCss(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "approved" or "completed" => "status-ok",
            "rejected" or "suspended" => "status-risk",
            _ => "status-pending"
        };
    }

    private static string TruncateText(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        if (value.Length <= maxLength)
        {
            return value;
        }

        return value[..maxLength] + "...";
    }

