                                <div class="col-md-6">
                                    <div class="border rounded p-3 h-100 bg-light-subtle">
                                        <div class="small text-muted text-uppercase">Carer</div>
                                        <div>@selectedCarerStudentTimeOffRequest.Username (@selectedCarerStudentTimeOffRequest.CarerId)</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="border rounded p-3 h-100 bg-light-subtle">
                                        <div class="small text-muted text-uppercase">Student</div>
                                        <div>@selectedCarerStudentTimeOffRequest.StudentDisplayName (@selectedCarerStudentTimeOffRequest.StudentIdentifier)</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="border rounded p-3 h-100 bg-light-subtle">
                                        <div class="small text-muted text-uppercase">Request Type</div>
                                        <div>@selectedCarerStudentTimeOffRequest.RequestType</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="border rounded p-3 h-100 bg-light-subtle">
                                        <div class="small text-muted text-uppercase">Date Range</div>
                                        <div>@selectedCarerStudentTimeOffRequest.StartDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) - @selectedCarerStudentTimeOffRequest.EndDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</div>
