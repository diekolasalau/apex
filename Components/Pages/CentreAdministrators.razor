                                </div>
                                <div class="col-md-6">
                                    <div class="border rounded p-3 h-100 bg-light-subtle">
                                        <div class="small text-muted text-uppercase">Total Days</div>
                                        <div>@selectedCarerStudentTimeOffRequest.TotalDays</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="border rounded p-3 h-100 bg-light-subtle">
                                        <div class="small text-muted text-uppercase">Reason</div>
                                        <div>@DisplayValue(selectedCarerStudentTimeOffRequest.Reason)</div>
                                    </div>
                                </div>
