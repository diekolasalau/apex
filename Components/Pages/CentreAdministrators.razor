                                <button class="btn btn-danger" @onclick="RejectSelectedCarerStudentTimeOffRequestAsync" disabled="@(isSavingCarerTimeOffDecision || IsTimeOffDecisionLocked(selectedCarerStudentTimeOffRequest.ApprovalStatus))">Reject</button>
