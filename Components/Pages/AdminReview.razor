    private void InitializeTutorPlanningDrafts()
    {
        tutorCoursesDrafts = approvedTutors.ToDictionary(
            t => t.Id,
            t => t.CoursesToBeTaken ?? string.Empty);

        tutorDaySelections = approvedTutors.ToDictionary(
            t => t.Id,
            t => ParseTutorDaySelection(t.CourseDuration));

        tutorDaysDrafts = approvedTutors.ToDictionary(
            t => t.Id,
            t => string.Join(", ", WeekdayOptions.Where(day => tutorDaySelections[t.Id].Contains(day))));

        tutorStartTimeDrafts = approvedTutors.ToDictionary(
            t => t.Id,
            t => ParseTutorStartTime(t.CourseDuration));

        tutorFinishTimeDrafts = approvedTutors.ToDictionary(
            t => t.Id,
            t => ParseTutorFinishTime(t.CourseDuration));

        tutorHoursPerDayDrafts = approvedTutors.ToDictionary(
            t => t.Id,
            t => ParseTutorHoursPerDay(t.CourseDuration));
    }

    private string GetTutorCoursesDraft(int tutorId)
    {
        return tutorCoursesDrafts.TryGetValue(tutorId, out var value) ? value : string.Empty;
    }

    private string GetTutorDaysDraft(int tutorId)
    {
        return tutorDaysDrafts.TryGetValue(tutorId, out var value) ? value : string.Empty;
    }

    private string GetTutorDaysSummary(int tutorId)
    {
        var value = GetTutorDaysDraft(tutorId);
        return string.IsNullOrWhiteSpace(value) ? "Select day(s)" : value;
    }

    private string GetTutorStartTimeDraft(int tutorId)
    {
        return tutorStartTimeDrafts.TryGetValue(tutorId, out var value) ? value : string.Empty;
    }

    private string GetTutorFinishTimeDraft(int tutorId)
    {
        return tutorFinishTimeDrafts.TryGetValue(tutorId, out var value) ? value : string.Empty;
    }

    private string GetTutorHoursPerDayDraft(int tutorId)
    {
        return tutorHoursPerDayDrafts.TryGetValue(tutorId, out var value) ? value : string.Empty;
    }

    private string GetTutorComputedHoursDraft(int tutorId)
    {
        var computed = ComputeHoursPerDay(tutorId);
        return string.IsNullOrWhiteSpace(computed) ? GetTutorHoursPerDayDraft(tutorId) : computed;
    }

    private string? GetTutorTimeValidationError(int tutorId)
    {
        var startValue = GetTutorStartTimeDraft(tutorId);
        var finishValue = GetTutorFinishTimeDraft(tutorId);

        if (string.IsNullOrWhiteSpace(startValue) && string.IsNullOrWhiteSpace(finishValue))
        {
            return null;
        }

        if (string.IsNullOrWhiteSpace(startValue) || string.IsNullOrWhiteSpace(finishValue))
        {
            return "Enter both start and finish time.";
        }

        if (!TimeOnly.TryParse(startValue, out var startTime) || !TimeOnly.TryParse(finishValue, out var finishTime))
        {
            return "Enter valid start and finish times.";
        }

        var duration = finishTime - startTime;
        if (duration <= TimeSpan.Zero)
        {
            return "Finish time must be after start time.";
        }

        var hours = (decimal)duration.TotalHours;
        if (hours < 0.5m || hours > 12m)
        {
            return "Hours per day must be between 0.5 and 12.";
        }

        return null;
    }

    private void OnTutorCoursesChanged(int tutorId, string? value)
    {
        tutorCoursesDrafts[tutorId] = value ?? string.Empty;
    }

    private bool IsTutorDaySelected(int tutorId, string day)
    {
        return tutorDaySelections.TryGetValue(tutorId, out var selections) && selections.Contains(day);
    }

    private void OnTutorDayToggle(int tutorId, string day, ChangeEventArgs args)
    {
        if (!tutorDaySelections.TryGetValue(tutorId, out var selections))
        {
            selections = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            tutorDaySelections[tutorId] = selections;
        }

        var isChecked = args.Value is bool b && b;
        if (isChecked)
        {
            selections.Add(day);
        }
        else
        {
            selections.Remove(day);
        }

        tutorDaysDrafts[tutorId] = string.Join(", ", WeekdayOptions.Where(option => selections.Contains(option)));
    }

    private void OnTutorHoursPerDayChanged(int tutorId, string? value)
    {
        tutorHoursPerDayDrafts[tutorId] = NormalizeHoursForInput(value);
    }

    private void OnTutorStartTimeChanged(int tutorId, string? value)
    {
        tutorStartTimeDrafts[tutorId] = value?.Trim() ?? string.Empty;
        tutorHoursPerDayDrafts[tutorId] = ComputeHoursPerDay(tutorId);
    }

    private void OnTutorFinishTimeChanged(int tutorId, string? value)
    {
        tutorFinishTimeDrafts[tutorId] = value?.Trim() ?? string.Empty;
        tutorHoursPerDayDrafts[tutorId] = ComputeHoursPerDay(tutorId);
    }

    private string ComputeHoursPerDay(int tutorId)
    {
        var startValue = GetTutorStartTimeDraft(tutorId);
        var finishValue = GetTutorFinishTimeDraft(tutorId);
        if (!TimeOnly.TryParse(startValue, out var startTime) || !TimeOnly.TryParse(finishValue, out var finishTime))
        {
            return string.Empty;
        }

        var duration = finishTime - startTime;
        if (duration <= TimeSpan.Zero)
        {
            return string.Empty;
        }

        var hours = (decimal)duration.TotalHours;
        return hours.ToString("0.##");
    }

    private static string ParseTutorDays(string? courseDuration)
    {
        if (string.IsNullOrWhiteSpace(courseDuration))
        {
            return string.Empty;
        }

        const string daysPrefix = "Days:";
        const string separator = "; Hours/Day:";
        var value = courseDuration.Trim();
        if (!value.StartsWith(daysPrefix, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        var separatorIndex = value.IndexOf(separator, StringComparison.OrdinalIgnoreCase);
        if (separatorIndex < 0)
        {
            return value[daysPrefix.Length..].Trim();
        }

        return value.Substring(daysPrefix.Length, separatorIndex - daysPrefix.Length).Trim();
    }

    private static HashSet<string> ParseTutorDaySelection(string? courseDuration)
    {
        var selections = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var parsed = ParseTutorDays(courseDuration);
        if (string.IsNullOrWhiteSpace(parsed))
        {
            return selections;
        }

        var parts = parsed.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var part in parts)
        {
            var normalized = NormalizeWeekday(part);
            if (!string.IsNullOrWhiteSpace(normalized))
            {
                selections.Add(normalized);
            }
        }

        return selections;
    }

    private static string? NormalizeWeekday(string value)
    {
        return value.Trim().ToLowerInvariant() switch
        {
            "monday" or "mon" => "Mon",
            "tuesday" or "tue" or "tues" => "Tue",
            "wednesday" or "wed" => "Wed",
            "thursday" or "thu" or "thur" or "thurs" => "Thu",
            "friday" or "fri" => "Fri",
            "saturday" or "sat" => "Sat",
            "sunday" or "sun" => "Sun",
            _ => null
        };
    }

    private static string ParseTutorHoursPerDay(string? courseDuration)
    {
        if (string.IsNullOrWhiteSpace(courseDuration))
        {
            return string.Empty;
        }

        const string separator = "; Hours/Day:";
        var value = courseDuration.Trim();
        var separatorIndex = value.IndexOf(separator, StringComparison.OrdinalIgnoreCase);
        if (separatorIndex < 0)
        {
            return value;
        }

        return NormalizeHoursForInput(value[(separatorIndex + separator.Length)..]);
    }

    private static string ParseTutorStartTime(string? courseDuration)
    {
        if (string.IsNullOrWhiteSpace(courseDuration))
        {
            return string.Empty;
        }

        const string timePrefix = "; Time:";
        const string hoursSeparator = "; Hours/Day:";
        var value = courseDuration.Trim();
        var timeIndex = value.IndexOf(timePrefix, StringComparison.OrdinalIgnoreCase);
        if (timeIndex < 0)
        {
            return string.Empty;
        }

        var startIndex = timeIndex + timePrefix.Length;
        var hoursIndex = value.IndexOf(hoursSeparator, startIndex, StringComparison.OrdinalIgnoreCase);
        var timeSegment = hoursIndex >= 0
            ? value.Substring(startIndex, hoursIndex - startIndex)
            : value[startIndex..];

        var parts = timeSegment.Split('-', StringSplitOptions.TrimEntries);
        return parts.Length == 2 ? parts[0] : string.Empty;
    }

    private static string ParseTutorFinishTime(string? courseDuration)
    {
        if (string.IsNullOrWhiteSpace(courseDuration))
        {
            return string.Empty;
        }

        const string timePrefix = "; Time:";
        const string hoursSeparator = "; Hours/Day:";
        var value = courseDuration.Trim();
        var timeIndex = value.IndexOf(timePrefix, StringComparison.OrdinalIgnoreCase);
        if (timeIndex < 0)
        {
            return string.Empty;
        }

        var startIndex = timeIndex + timePrefix.Length;
        var hoursIndex = value.IndexOf(hoursSeparator, startIndex, StringComparison.OrdinalIgnoreCase);
        var timeSegment = hoursIndex >= 0
            ? value.Substring(startIndex, hoursIndex - startIndex)
            : value[startIndex..];

        var parts = timeSegment.Split('-', StringSplitOptions.TrimEntries);
        return parts.Length == 2 ? parts[1] : string.Empty;
    }

    private static string NormalizeHoursForInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var normalized = value.Trim().Replace("hours", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("hour", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Trim();

        return normalized;
    }

