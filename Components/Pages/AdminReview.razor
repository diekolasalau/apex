    private async Task SelectStudentForAssignmentAsync(int studentId)
    {
        if (!approvedStudents.Any(s => s.Id == studentId))
        {
            errorMessage = "Only approved students can be assigned to a tutor.";
            successMessage = null;
            return;
        }

        var selectedStudent = approvedStudents.First(s => s.Id == studentId);
        if (!string.IsNullOrWhiteSpace(selectedStudent.AssignedTutorName))
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"{selectedStudent.FirstName} {selectedStudent.LastName} is currently assigned to {selectedStudent.AssignedTutorName}. Continue adding another tutor?");

            if (!confirmed)
            {
                return;
            }
        }

        selectedStudentId = studentId;
        selectedTutorIds = new HashSet<int>();
        InitializeTutorPlanningDrafts();
        successMessage = null;
        errorMessage = null;
    }

    private void CloseStudentDetail()
    {
        selectedStudentId = null;
        selectedTutorIds.Clear();
        errorMessage = null;
        successMessage = null;
    }

    private async Task AssignTutorToStudent()
    {
        errorMessage = null;
        successMessage = null;

        if (!selectedStudentId.HasValue || selectedTutorIds.Count == 0)
        {
            errorMessage = "Select a student and at least one tutor before assigning.";
            return;
        }

        var selectedTutors = approvedTutors
            .Where(t => selectedTutorIds.Contains(t.Id))
            .ToList();

        if (selectedTutors.Count == 0)
        {
            errorMessage = "Selected tutor(s) not found or not approved.";
            return;
        }

        var assignedTutorNames = new List<string>();
        foreach (var tutor in selectedTutors)
        {
            var timeValidationError = GetTutorTimeValidationError(tutor.Id);
            if (!string.IsNullOrWhiteSpace(timeValidationError))
            {
                errorMessage = $"{tutor.FirstName} {tutor.LastName}: {timeValidationError}";
                return;
            }

            var planningUpdated = await TutorService.UpdateCoursePlanningAsync(
                tutor.Id,
                GetTutorCoursesDraft(tutor.Id),
                GetTutorDaysDraft(tutor.Id),
                GetTutorComputedHoursDraft(tutor.Id),
                GetTutorStartTimeDraft(tutor.Id),
                GetTutorFinishTimeDraft(tutor.Id),
                AdminSession.Username ?? "Admin");

            if (!planningUpdated)
            {
                errorMessage = $"Unable to save course planning for tutor #{tutor.Id}.";
                continue;
            }

            var assigned = await StudentService.AssignTutorAsync(selectedStudentId.Value, tutor.Id, $"{tutor.FirstName} {tutor.LastName}");
            if (assigned)
            {
                assignedTutorNames.Add($"{tutor.FirstName} {tutor.LastName}");
            }
        }

        if (assignedTutorNames.Count > 0)
        {
            successMessage = $"Student #{selectedStudentId.Value} has been assigned to: {string.Join(", ", assignedTutorNames)}.";
            await LoadDataAsync();
        }
        else
        {
            errorMessage = "Failed to assign the selected tutor(s).";
        }
    }

