@page "/password-reset-request"
@using StudyMgt.Services
@inject CentreAdminAccessService AdminAccess
@inject AppAuditLogService AuditLog
@inject NavigationManager Navigation

<PageTitle>Reset Password - Centre Administrator</PageTitle>

<div class="auth-container">
    <div class="auth-card" style="max-width: 480px;">
        <h1>Reset Your Password</h1>
        <p class="text-muted">Enter your email address and we'll send you a password reset link.</p>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (!resetLinkSent)
        {
            <form @onsubmit="RequestPasswordResetAsync">
                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <InputText class="form-control" @bind-Value="email" type="email" placeholder="admin@example.com" required />
                </div>
                <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Reset Link</span>
                    }
                </button>
            </form>
        }

        <hr />
        <p class="text-center">
            <a href="/centre-administrators">Back to Sign In</a>
        </p>
    </div>
</div>

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 20px;
    }

    .auth-card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 40px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .auth-card h1 {
        margin-bottom: 10px;
        font-size: 28px;
        font-weight: 600;
        color: #333;
    }

    .auth-card p {
        margin-bottom: 30px;
        font-size: 14px;
    }

    .auth-card hr {
        margin: 25px 0;
        border: 0;
        border-top: 1px solid #e0e0e0;
    }

    .text-center {
        text-align: center;
        font-size: 14px;
    }

    .text-center a {
        color: #007bff;
        text-decoration: none;
    }

    .text-center a:hover {
        text-decoration: underline;
    }
</style>

@code {
    private string? email;
    private string? errorMessage;
    private string? successMessage;
    private bool resetLinkSent = false;
    private bool isSubmitting = false;

    private async Task RequestPasswordResetAsync()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Please enter your email address.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var resetToken = await AdminAccess.GeneratePasswordResetTokenAsync(email);
            
            if (resetToken != null)
            {
                // In a real application, you would send this token via email
                // For now, we'll display a success message
                await AuditLog.LogAsync(
                    eventType: "Security",
                    action: "PasswordResetRequested",
                    pagePath: "/password-reset-request",
                    actorRole: "CentreAdmin",
                    actorUsername: email,
                    success: true,
                    details: $"Password reset token generated for {email}");

                // Store token in session for demo purposes (in production, send via email)
                successMessage = $"Password reset instructions have been generated. Reset token: {resetToken}";
                resetLinkSent = true;
            }
            else
            {
                errorMessage = "No account found with this email address.";
                await AuditLog.LogAsync(
                    eventType: "Security",
                    action: "PasswordResetRequestedInvalidEmail",
                    pagePath: "/password-reset-request",
                    actorRole: "CentreAdmin",
                    actorUsername: email,
                    success: false,
                    details: "Password reset requested for non-existent email.");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred. Please try again.";
            await AuditLog.LogAsync(
                eventType: "Security",
                action: "PasswordResetRequestError",
                pagePath: "/password-reset-request",
                actorRole: "CentreAdmin",
                actorUsername: email,
                success: false,
                details: $"Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
