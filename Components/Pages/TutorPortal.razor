    private void ClearMessages()
    {
        successMessage = null;
        errorMessage = null;
        remainingLoginAttempts = null;
        lockoutRemainingMinutes = null;
        isLockedOut = false;
    }

    private async Task Logout(string message = "You have been logged out successfully.")
    {
        var tutorId = PortalSession.TutorOnboardingId;
        var currentUsername = PortalSession.Username;
        var sessionLogId = PortalSession.CurrentSessionLogId;

        if (tutorId.HasValue && !string.IsNullOrWhiteSpace(currentUsername))
        {
            await PortalService.RecordLogoutAsync(tutorId.Value, currentUsername, sessionLogId);
        }

        await AuditLog.LogAsync(
            eventType: "Security",
            action: "TutorPortalLogout",
            pagePath: "/tutor-portal",
            actorRole: "Tutor",
            actorUsername: PortalSession.Username,
            entityType: "TutorOnboarding",
            entityId: PortalSession.TutorOnboardingId?.ToString(),
            success: true,
            details: "Tutor signed out of portal.");

        PortalSession.SignOut();
        profile = null;
        students.Clear();
        timesheets.Clear();
        timeOffBookings.Clear();
        selectedStudentForAttendanceId = null;
        attendanceStateByStudentId.Clear();
        loginPassword = null;
        loginUsername = null;
        ClearMessages();
        successMessage = message;
    }

    private string GetTutorCoursesForStudentTable()
    {
        return string.IsNullOrWhiteSpace(profile?.CoursesToBeTaken) ? "-" : profile.CoursesToBeTaken;
    }

    private string GetTutorDaysForStudentTable()
    {
        return ParseTutorCourseDuration().Days;
    }

    private string GetTutorStartTimeForStudentTable()
    {
        return ParseTutorCourseDuration().StartTime;
    }

    private string GetTutorFinishTimeForStudentTable()
    {
        return ParseTutorCourseDuration().FinishTime;
    }

    private (string Days, string StartTime, string FinishTime) ParseTutorCourseDuration()
    {
        var courseDuration = profile?.CourseDuration;
        if (string.IsNullOrWhiteSpace(courseDuration))
        {
            return ("-", "-", "-");
        }

        var days = "-";
        var startTime = "-";
        var finishTime = "-";

        var parts = courseDuration.Split(';', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            if (part.StartsWith("Days:", StringComparison.OrdinalIgnoreCase))
            {
                var parsedDays = part[5..].Trim();
                days = string.IsNullOrWhiteSpace(parsedDays) ? "-" : parsedDays;
                continue;
            }

            if (part.StartsWith("Time:", StringComparison.OrdinalIgnoreCase))
            {
                var parsedTime = part[5..].Trim();
                if (!string.IsNullOrWhiteSpace(parsedTime))
                {
                    var timeParts = parsedTime.Split('-', StringSplitOptions.TrimEntries);
                    if (timeParts.Length == 2)
                    {
                        startTime = string.IsNullOrWhiteSpace(timeParts[0]) ? "-" : timeParts[0];
                        finishTime = string.IsNullOrWhiteSpace(timeParts[1]) ? "-" : timeParts[1];
                    }
                }

                continue;
            }

            if (part.StartsWith("Hours/Day:", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            // Backward-compatible parse for legacy strings that may only store day values.
            if (days == "-")
            {
                days = part;
            }
        }

        return (days, startTime, finishTime);
    }
}